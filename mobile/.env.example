# Copy to .env (never commit .env). Public values only: the anon key is safe to ship because Row Level Security
# protects the data. NEVER put the service-role key or any payment key here. The app never asks for a mobile money PIN.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: filled in by `eas init` (needed for push notifications)
EAS_PROJECT_ID=
