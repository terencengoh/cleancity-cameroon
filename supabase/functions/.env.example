# Copy to supabase/functions/.env for local `supabase functions serve`, and set the same keys in production with
# `supabase secrets set --env-file supabase/functions/.env`. NEVER commit real values.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Which adapter sends worker payouts: campay | notchpay
PAYOUT_PROVIDER=campay

# CamPay (https://www.campay.net): sandbox base URL shown; live: https://www.campay.net/api
# Payouts use /withdraw/: enable withdrawals for the app in the CamPay dashboard and fund the balance.
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=replace-with-app-username
CAMPAY_PASSWORD=replace-with-app-password
CAMPAY_WEBHOOK_KEY=replace-with-app-webhook-key

# Notch Pay (https://notchpay.co): transfers need the private key (X-Grant) AND a whitelisted caller IP.
# Edge Functions have no fixed IP, so route transfers through a static-IP proxy if you use Notch Pay.
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=replace-with-public-key
NOTCHPAY_WEBHOOK_HASH=replace-with-webhook-hash-key
NOTCHPAY_PRIVATE_KEY=replace-with-private-key

# Expo push (optional; only if "enhanced push security" is enabled in your Expo account)
EXPO_ACCESS_TOKEN=
